      <AssemblerScript>{ Game   : Dead Space.exe
  Version: 
  Date   : 2026-07-24
  Author : 1

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
aobscanmodule(INJECT1,Dead Space.exe,5E 83 C4 0C C3 CC CC CC CC 83 EC 10) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  push eax
  mov esi,INJECT1
  sub esi,0x4
  mov esi,[esi]
  sub esi,0xC
  mov eax,[esi]
  cmp eax,[CP0]
  jne code
  mov eax,[CP1]
  mov [esi],eax
  mov eax,[CP1+4]
  mov [esi+4],eax

code:
  pop eax
  pop esi
  add esp,0C
  ret 
  jmp return

CP0:
  db 9C A9 C8 4B BB DB 22 D6
CP1:
  db D0 41 C8 4B 0C 6B CF 58

INJECT1:
  jmp newmem
return:
registersymbol(INJECT1)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
INJECT1:
  db 5E 83 C4 0C C3

unregistersymbol(INJECT1)
dealloc(newmem)

{
