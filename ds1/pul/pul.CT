//code from here to '[DISABLE]' will be used to enable the cheat
luacall(openProcess("Dead Space.exe")) 
aobscanmodule(INJECT_pul,Dead Space.exe,68 1C 45 00 00) // should be unique
alloc(newmem,$100)

label(code)
label(return)
label(script)
label(end)

newmem:

code:
  mov ecx,end
  sub ecx,script
  sub ecx,1
  mov [esp+4],ecx
  mov ecx, script
  jmp return

script:
  db ' dofile("player_upgrades.lua")' 00
end:

INJECT_pul+10:
  jmp short +4e
  nop
return:

INJECT_pul+60:
  jmp newmem

registersymbol(INJECT_pul)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
INJECT_pul+10:
  sar edi, 3
INJECT_pul+60:
  db cc cc cc cc cc

unregistersymbol(INJECT_pul)
dealloc(newmem)

