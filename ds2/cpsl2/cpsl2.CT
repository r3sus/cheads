      <AssemblerScript>{ Game   : deadspace2.exe (paused)
  Version: 
  Date   : 2026-07-24
  Author : 1

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
aobscanmodule(INJECT2,deadspace2.exe,8B 4C 24 0C 50 8B 44 24 14 50 51 8B) // should be unique
alloc(newmem,$1000)

label(code)
label(return)

newmem:
  push eax
  push ebx

  mov esi,INJECT2
  add esi,81
  sub esi,0x4
  mov esi,[esi]
  sub esi,0xC

  xor ebx,ebx

loop1:
  mov eax,[esi+ebx*4]
  cmp eax,[CP0+ebx*4]
  jne code
  inc ebx
  cmp ebx,4
  jne loop1

  xor ebx,ebx

loop2:
  mov eax,[CP1+ebx*4]
  mov [esi+ebx*4],eax
  inc ebx
  cmp ebx,4
  jne loop2

code:
  pop ebx
  pop eax
  pop esi
  ret
  jmp return

CP0:
  db 0B C5 C9 4B 2A 59 8B C0 43 45 4E 54 4B 4F 57 53
CP1:
  db 94 19 CB 36 15 E4 63 66 50 41 54 45 4C 31 30 32

INJECT2+93-12:
  jmp newmem
return:
registersymbol(INJECT2)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
INJECT2+93-12:
  pop esi
  ret

unregistersymbol(INJECT2)
dealloc(newmem)

